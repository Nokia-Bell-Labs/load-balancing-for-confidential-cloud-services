@@ -0,0 +1,74 @@
+#!/bin/bash
+#
+# Generate persistent CA certificates for testing
+# These certificates will be valid for 10 years
+#
+
+set -e
+
+CA_DIR="$(cd "$(dirname "$0")" && pwd)"
+cd "$CA_DIR"
+
+# Generate Root CA
+if [ ! -f root-ca-key.pem ]; then
+    echo "Generating Root CA..."
+    openssl genrsa -out root-ca-key.pem 4096
+    
+    openssl req -new -x509 -days 3650 -key root-ca-key.pem -out root-ca.pem \
+        -subj "/C=US/ST=Test/L=Test/O=Janus Test CA/CN=Janus Test Root CA" \
+        -extensions v3_ca
+    
+    echo "✓ Root CA created (valid for 10 years)"
+else
+    echo "✓ Root CA already exists"
+fi
+
+# Generate Intermediate CA
+if [ ! -f intermediate-ca-key.pem ]; then
+    echo "Generating Intermediate CA..."
+    openssl genrsa -out intermediate-ca-key.pem 4096
+    
+    # Create CSR for intermediate
+    openssl req -new -key intermediate-ca-key.pem -out intermediate-ca.csr \
+        -subj "/C=US/ST=Test/L=Test/O=Janus Test CA/CN=Janus Test Intermediate CA"
+    
+    # Sign intermediate with root CA
+    cat > intermediate-ext.cnf <<EOF
+basicConstraints = CA:TRUE, pathlen:0
+keyUsage = critical, digitalSignature, cRLSign, keyCertSign
+subjectKeyIdentifier = hash
+authorityKeyIdentifier = keyid:always
+EOF
+    
+    openssl x509 -req -days 3650 -in intermediate-ca.csr \
+        -CA root-ca.pem -CAkey root-ca-key.pem -CAcreateserial \
+        -out intermediate-ca.pem -extfile intermediate-ext.cnf
+    
+    rm -f intermediate-ca.csr intermediate-ext.cnf
+    
+    echo "✓ Intermediate CA created (valid for 10 years)"
+else
+    echo "✓ Intermediate CA already exists"
+fi
+
+# Create full chain (intermediate + root)
+cat intermediate-ca.pem root-ca.pem > ca-chain.pem
+echo "✓ Full chain created: ca-chain.pem"
+
+# Display certificate info
+echo ""
+echo "Root CA:"
+openssl x509 -in root-ca.pem -noout -subject -dates
+
+echo ""
+echo "Intermediate CA:"
+openssl x509 -in intermediate-ca.pem -noout -subject -dates -issuer
+
+echo ""
+echo "✅ Persistent CA certificates generated successfully!"
+echo ""
+echo "To use in browsers:"
+echo "  1. Import root-ca.pem into Firefox/Chrome certificate store"
+echo "  2. Trust it for 'Websites'"
+echo ""
+echo "These certificates are valid for 10 years and will persist across container restarts."
