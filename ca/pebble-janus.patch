+		},
+	})
+	t.Log("✓ CA initialized")
+
+	// 2. Generate test key
+	t.Log("\n[2/6] Generating test keypair...")
+	privateKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatalf("Failed to generate key: %v", err)
+	}
+	t.Log("✓ Keypair generated")
+
+	// 3. Create mock SGX quote
+	t.Log("\n[3/6] Creating mock SGX quote...")
+	mockSGXQuote := make([]byte, 4523) // Realistic SGX quote size
+	_, err = rand.Read(mockSGXQuote)
+	if err != nil {
+		t.Fatalf("Failed to generate mock quote: %v", err)
+	}
+	t.Logf("✓ Mock SGX quote created (%d bytes)", len(mockSGXQuote))
+
+	// 4. Create CSR with SGX extension
+	t.Log("\n[4/6] Creating CSR with SGX extension...")
+	sgxOID := asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 1}
+
+	template := &x509.CertificateRequest{
+		Subject: pkix.Name{
+			CommonName: "test-sgx.example.com",
+		},
+		DNSNames: []string{"test-sgx.example.com"},
+		ExtraExtensions: []pkix.Extension{
+			{
+				Id:       sgxOID,
+				Critical: false,
+				Value:    mockSGXQuote,
+			},
+		},
+	}
+
+	csrDER, err := x509.CreateCertificateRequest(rand.Reader, template, privateKey)
+	if err != nil {
+		t.Fatalf("Failed to create CSR: %v", err)
+	}
+
+	parsedCSR, err := x509.ParseCertificateRequest(csrDER)
+	if err != nil {
+		t.Fatalf("Failed to parse CSR: %v", err)
+	}
+
+	// Verify CSR has the extension
+	csrHasSGX := false
+	for _, ext := range parsedCSR.Extensions {
+		if ext.Id.Equal(sgxOID) {
+			csrHasSGX = true
+			t.Logf("✓ CSR contains SGX extension (OID: %v, %d bytes)", ext.Id, len(ext.Value))
+			break
+		}
+	}
+
+	if !csrHasSGX {
+		t.Fatal("CSR does not contain SGX extension")
+	}
+
+	// 5. Issue certificate using newCertificate (simulating CompleteOrder flow)
+	t.Log("\n[5/6] Issuing certificate with SGX extension...")
+
+	// Extract SGX extensions (this is what CompleteOrder does)
+	sgxExtensions := getSGXExtensions(parsedCSR.Extensions)
+	t.Logf("  Found %d SGX extension(s) in CSR", len(sgxExtensions))
+
+	// Issue certificate with SGX extensions
+	cert, err := ca.newCertificate(
+		parsedCSR.DNSNames,
+		[]net.IP{},
+		parsedCSR.PublicKey,
+		"test-account-123",
+		"",           // notBefore (empty = now)
+		"",           // notAfter (empty = default validity)
+		"default",    // profile
+		sgxExtensions, // extensions to include
+	)
+
+	if err != nil {
+		t.Fatalf("Failed to issue certificate: %v", err)
+	}
+
+	t.Logf("✓ Certificate issued (serial: %s)", cert.ID)
+
+	// 6. Verify issued certificate contains SGX extension
+	t.Log("\n[6/6] Verifying SGX extension in issued certificate...")
+
+	issuedCert := cert.Cert
+	certHasSGX := false
+	var foundExt pkix.Extension
+
+	for _, ext := range issuedCert.Extensions {
+		if ext.Id.Equal(sgxOID) {
+			certHasSGX = true
+			foundExt = ext
+			break
+		}
+	}
+
+	// Results
+	t.Log("\n" + strings.Repeat("=", 60))
+	t.Log("Test Results")
+	t.Log(strings.Repeat("=", 60))
+
+	if !certHasSGX {
+		t.Error("❌ FAILED: Certificate does NOT contain SGX extension")
+		t.Log("\nExtensions in certificate:")
+		for _, ext := range issuedCert.Extensions {
+			t.Logf("  - OID: %v", ext.Id)
+		}
+		t.Fatal("SGX extension missing from certificate")
+	}
+
+	// Success - verify details
+	t.Log("✅ SUCCESS: Certificate contains SGX extension!")
+	t.Logf("   OID: %v", foundExt.Id)
+	t.Logf("   Size: %d bytes", len(foundExt.Value))
+	t.Logf("   Critical: %v", foundExt.Critical)
+
+	// Verify data integrity
+	if len(foundExt.Value) != len(mockSGXQuote) {
+		t.Errorf("Extension size mismatch: expected %d bytes, got %d bytes",
+			len(mockSGXQuote), len(foundExt.Value))
+	} else {
+		t.Log("✓ Extension size matches original")
+	}
+
+	// Verify data matches byte-for-byte
+	dataMatches := true
+	for i := 0; i < len(mockSGXQuote); i++ {
+		if i >= len(foundExt.Value) || foundExt.Value[i] != mockSGXQuote[i] {
+			dataMatches = false
+			break
+		}
+	}
+
+	if !dataMatches {
+		t.Error("Extension data does not match original SGX quote")
+	} else {
+		t.Log("✓ Extension data matches original SGX quote byte-for-byte")
+	}
+
+	// Verify certificate structure
+	t.Log("\n✓ Certificate issued by: " + issuedCert.Issuer.String())
+	t.Log("✓ Certificate subject: " + issuedCert.Subject.String())
+	t.Logf("✓ Valid from: %v", issuedCert.NotBefore)
+	t.Logf("✓ Valid until: %v", issuedCert.NotAfter)
+	t.Logf("✓ Total extensions: %d", len(issuedCert.Extensions))
+
+	t.Log("\n" + strings.Repeat("=", 60))
+	t.Log("🎉 End-to-End Test PASSED!")
+	t.Log(strings.Repeat("=", 60))
+}
+
+// TestMultipleSGXExtensions tests that multiple SGX extensions are preserved
+func TestMultipleSGXExtensions(t *testing.T) {
+	t.Log("Testing multiple SGX extensions...")
+
+	// Setup CA
+	logger := log.New(os.Stdout, "TEST: ", log.LstdFlags)
+	ca := New(logger, db.NewMemoryStore(), "", "ecdsa", 0, 1, map[string]Profile{
+		"default": {ValidityPeriod: 7776000},
+	})
+
+	// Generate key
+	privateKey, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+
+	// Create CSR with 3 SGX extensions
+	quote := make([]byte, 100)
+	collateral := make([]byte, 200)
+	token := make([]byte, 300)
+
+	template := &x509.CertificateRequest{
+		Subject:  pkix.Name{CommonName: "multi-ext.example.com"},
+		DNSNames: []string{"multi-ext.example.com"},
+		ExtraExtensions: []pkix.Extension{
+			{Id: asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 1}, Value: quote},
+			{Id: asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 2}, Value: collateral},
+			{Id: asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 3}, Value: token},
+		},
+	}
+
+	csrDER, _ := x509.CreateCertificateRequest(rand.Reader, template, privateKey)
+	parsedCSR, _ := x509.ParseCertificateRequest(csrDER)
+
+	// Extract SGX extensions
+	sgxExts := getSGXExtensions(parsedCSR.Extensions)
+	t.Logf("Found %d SGX extensions in CSR", len(sgxExts))
+
+	if len(sgxExts) != 3 {
+		t.Fatalf("Expected 3 SGX extensions, got %d", len(sgxExts))
+	}
+
+	// Issue certificate
+	cert, err := ca.newCertificate(
+		parsedCSR.DNSNames,
+		[]net.IP{},
+		parsedCSR.PublicKey,
+		"test-account",
+		"", "", "default",
+		sgxExts,
+	)
+
+	if err != nil {
+		t.Fatalf("Failed to issue cert: %v", err)
+	}
+
+	// Count SGX extensions in issued certificate
+	sgxCount := 0
+	for _, ext := range cert.Cert.Extensions {
+		if isSGXExtension(ext.Id) {
+			sgxCount++
+			t.Logf("✓ Found SGX extension in cert: OID %v (%d bytes)",
+				ext.Id, len(ext.Value))
+		}
+	}
+
+	if sgxCount != 3 {
+		t.Errorf("Expected 3 SGX extensions in certificate, got %d", sgxCount)
+	} else {
+		t.Log("✅ All 3 SGX extensions preserved in certificate")
+	}
+}
diff --git a/ca/ca_sgx_test.go b/ca/ca_sgx_test.go
new file mode 100644
index 0000000..c4c9578
--- /dev/null
+++ b/ca/ca_sgx_test.go
@@ -0,0 +1,150 @@
+package ca
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/asn1"
+	"testing"
+)
+
+// Test that getSGXExtensions correctly extracts SGX extensions from CSR
+func TestGetSGXExtensions(t *testing.T) {
+	// Generate a test key
+	privateKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatalf("Failed to generate key: %v", err)
+	}
+
+	// Create mock SGX quote data
+	mockSGXQuote := make([]byte, 120)
+	for i := range mockSGXQuote {
+		mockSGXQuote[i] = byte(i % 256)
+	}
+
+	// Define SGX extension OID: 1.3.6.1.4.1.99999.3.1
+	sgxOID := asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 1}
+
+	// Create CSR with SGX extension
+	template := &x509.CertificateRequest{
+		Subject: pkix.Name{
+			CommonName: "test.example.com",
+		},
+		ExtraExtensions: []pkix.Extension{
+			{
+				Id:       sgxOID,
+				Critical: false,
+				Value:    mockSGXQuote,
+			},
+		},
+	}
+
+	csrDER, err := x509.CreateCertificateRequest(rand.Reader, template, privateKey)
+	if err != nil {
+		t.Fatalf("Failed to create CSR: %v", err)
+	}
+
+	csr, err := x509.ParseCertificateRequest(csrDER)
+	if err != nil {
+		t.Fatalf("Failed to parse CSR: %v", err)
+	}
+
+	// Verify CSR has SGX extension
+	found := false
+	for _, ext := range csr.Extensions {
+		if ext.Id.Equal(sgxOID) {
+			found = true
+			t.Logf("✓ CSR contains SGX extension (OID: %v, %d bytes)", ext.Id, len(ext.Value))
+			break
+		}
+	}
+
+	if !found {
+		t.Fatal("CSR does not contain SGX extension")
+	}
+
+	// Test getSGXExtensions function
+	t.Log("Testing getSGXExtensions()...")
+	sgxExts := getSGXExtensions(csr.Extensions)
+
+	if len(sgxExts) == 0 {
+		t.Fatal("❌ FAILED: getSGXExtensions() returned no extensions")
+	}
+
+	t.Logf("✅ SUCCESS: getSGXExtensions() found %d SGX extension(s)", len(sgxExts))
+
+	// Verify the extension
+	for _, ext := range sgxExts {
+		t.Logf("   OID: %v", ext.Id)
+		t.Logf("   Size: %d bytes", len(ext.Value))
+		t.Logf("   Critical: %v", ext.Critical)
+
+		if !ext.Id.Equal(sgxOID) {
+			t.Errorf("Wrong OID: expected %v, got %v", sgxOID, ext.Id)
+		}
+
+		if len(ext.Value) != len(mockSGXQuote) {
+			t.Errorf("Wrong size: expected %d, got %d", len(mockSGXQuote), len(ext.Value))
+		}
+	}
+
+	t.Log("✓ SGX extension extraction verified")
+}
+
+// Test that isSGXExtension correctly identifies SGX OIDs
+func TestIsSGXExtension(t *testing.T) {
+	tests := []struct {
+		name     string
+		oid      asn1.ObjectIdentifier
+		expected bool
+	}{
+		{
+			name:     "SGX Quote OID",
+			oid:      asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 1},
+			expected: true,
+		},
+		{
+			name:     "SGX Collateral OID",
+			oid:      asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 2},
+			expected: true,
+		},
+		{
+			name:     "SGX Token OID",
+			oid:      asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 3},
+			expected: true,
+		},
+		{
+			name:     "Wrong TEE type",
+			oid:      asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 2, 1}, // SEV-SNP
+			expected: false,
+		},
+		{
+			name:     "Wrong prefix",
+			oid:      asn1.ObjectIdentifier{1, 3, 6, 1, 5, 5, 7, 1, 24}, // OCSP Must-Staple
+			expected: false,
+		},
+		{
+			name:     "Too short",
+			oid:      asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3},
+			expected: false,
+		},
+		{
+			name:     "Too long",
+			oid:      asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 1, 1},
+			expected: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			result := isSGXExtension(tt.oid)
+			if result != tt.expected {
+				t.Errorf("isSGXExtension(%v) = %v, expected %v", tt.oid, result, tt.expected)
+			} else {
+				t.Logf("✓ isSGXExtension(%v) = %v", tt.oid, result)
+			}
+		})
+	}
+}
