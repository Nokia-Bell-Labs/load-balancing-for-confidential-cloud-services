+// TestCompleteOrderWithSGXExtension tests the ACTUAL CompleteOrder() flow
+// This is what happens when a real ACME client submits a CSR with SGX extensions
+func TestCompleteOrderWithSGXExtension(t *testing.T) {
+	t.Log(strings.Repeat("=", 60))
+	t.Log("CompleteOrder() Integration Test - REAL ACME FLOW")
+	t.Log(strings.Repeat("=", 60))
+
+	// 1. Setup CA
+	t.Log("\n[1/7] Setting up Pebble CA...")
+	logger := log.New(os.Stdout, "PEBBLE CA: ", log.LstdFlags)
+	testDB := db.NewMemoryStore()
+
+	ca := New(logger, testDB, "", "ecdsa", 0, 1, map[string]Profile{
+		"default": {
+			Description:       "Test profile",
+			PromoteCommonName: false,
+			ValidityPeriod:    7776000,
+		},
+	})
+	t.Log("✓ Pebble CA initialized with root and intermediate certificates")
+
+	// 2. Generate keypair
+	t.Log("\n[2/7] Generating client keypair...")
+	privateKey, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatalf("Failed to generate key: %v", err)
+	}
+	t.Log("✓ Client keypair generated")
+
+	// 3. Create mock SGX quote (realistic size)
+	t.Log("\n[3/7] Creating mock SGX quote...")
+	mockSGXQuote := make([]byte, 4800) // Realistic SGX DCAP quote size
+	_, err = rand.Read(mockSGXQuote)
+	if err != nil {
+		t.Fatalf("Failed to generate mock quote: %v", err)
+	}
+	t.Logf("✓ Mock SGX quote created (%d bytes)", len(mockSGXQuote))
+
+	// 4. Create CSR with SGX extension
+	t.Log("\n[4/7] Client creating CSR with SGX extension...")
+	sgxOID := asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 1}
+
+	csrTemplate := &x509.CertificateRequest{
+		Subject: pkix.Name{
+			CommonName: "sgx-enclave.example.com",
+		},
+		DNSNames: []string{"sgx-enclave.example.com"},
+		ExtraExtensions: []pkix.Extension{
+			{
+				Id:       sgxOID,
+				Critical: false,
+				Value:    mockSGXQuote,
+			},
+		},
+	}
+
+	csrDER, err := x509.CreateCertificateRequest(rand.Reader, csrTemplate, privateKey)
+	if err != nil {
+		t.Fatalf("Failed to create CSR: %v", err)
+	}
+
+	parsedCSR, err := x509.ParseCertificateRequest(csrDER)
+	if err != nil {
+		t.Fatalf("Failed to parse CSR: %v", err)
+	}
+
+	// Verify CSR has SGX extension
+	csrHasSGX := false
+	for _, ext := range parsedCSR.Extensions {
+		if ext.Id.Equal(sgxOID) {
+			csrHasSGX = true
+			t.Logf("✓ CSR contains SGX extension (OID: %v, %d bytes)", ext.Id, len(ext.Value))
+			break
+		}
+	}
+
+	if !csrHasSGX {
+		t.Fatal("CSR does not contain SGX extension")
+	}
+
+	// 5. Create Order object (simulating ACME order)
+	t.Log("\n[5/7] Creating ACME order...")
+	order := &core.Order{
+		ID:        "test-order-sgx-12345",
+		AccountID: "acct-test-123",
+		ParsedCSR: parsedCSR,
+		Order: acme.Order{
+			Status: acme.StatusReady,
+		},
+	}
+	order.Order.Profile = "default" // Set profile name
+
+	// Mark order as ready for processing
+	order.BeganProcessing = true
+
+	// Create mock authorization (valid)
+	mockAuthz := &core.Authorization{}
+	mockAuthz.Status = acme.StatusValid
+	order.AuthorizationObjects = []*core.Authorization{mockAuthz}
+
+	t.Logf("✓ ACME order created (ID: %s)", order.ID)
+	t.Log("  Order status: ready")
+	t.Log("  Authorizations: valid")
+
+	// 6. Call CompleteOrder() - THIS IS THE CRITICAL CODE PATH
+	t.Log("\n[6/7] Calling CompleteOrder() - THE ACTUAL PRODUCTION CODE PATH...")
+	t.Log("  This simulates what happens when an ACME client finalizes an order")
+
+	// THIS IS THE REAL TEST - Does CompleteOrder() preserve SGX extensions?
+	ca.CompleteOrder(order)
+
+	// Check if certificate was issued
+	if order.CertificateObject == nil {
+		t.Fatal("❌ FAILED: CompleteOrder() did not issue a certificate")
+	}
+
+	issuedCert := order.CertificateObject.Cert
+	t.Logf("✓ Certificate issued by CompleteOrder()")
+	t.Logf("  Serial: %s", order.CertificateObject.ID)
+	t.Logf("  Issuer: %s", issuedCert.Issuer.String())
+
+	// 7. Verify SGX extension in issued certificate
+	t.Log("\n[7/7] Verifying SGX extension in final certificate...")
+
+	certHasSGX := false
+	var foundExt pkix.Extension
+
+	for _, ext := range issuedCert.Extensions {
+		if ext.Id.Equal(sgxOID) {
+			certHasSGX = true
+			foundExt = ext
+			break
+		}
+	}
+
+	// Results
+	t.Log("\n" + strings.Repeat("=", 60))
+	t.Log("Test Results - CompleteOrder() Flow")
+	t.Log(strings.Repeat("=", 60))
+
+	if !certHasSGX {
+		t.Error("❌ FAILED: Certificate does NOT contain SGX extension")
+		t.Log("\nExtensions in certificate:")
+		for _, ext := range issuedCert.Extensions {
+			t.Logf("  - OID: %v", ext.Id)
+		}
+		t.Fatal("CompleteOrder() did not preserve SGX extension")
+	}
+
+	// SUCCESS - Verify all details
+	t.Log("\n✅ SUCCESS: CompleteOrder() preserved SGX extension!")
+	t.Logf("   OID: %v", foundExt.Id)
+	t.Logf("   Size: %d bytes", len(foundExt.Value))
+	t.Logf("   Critical: %v", foundExt.Critical)
+
+	// Verify data integrity
+	if len(foundExt.Value) != len(mockSGXQuote) {
+		t.Errorf("Extension size mismatch: expected %d bytes, got %d bytes",
+			len(mockSGXQuote), len(foundExt.Value))
+	} else {
+		t.Log("✓ Extension size matches original SGX quote")
+	}
+
+	// Verify data matches byte-for-byte
+	dataMatches := true
+	for i := 0; i < len(mockSGXQuote); i++ {
+		if i >= len(foundExt.Value) || foundExt.Value[i] != mockSGXQuote[i] {
+			dataMatches = false
+			break
+		}
+	}
+
+	if !dataMatches {
+		t.Error("Extension data does not match original SGX quote")
+	} else {
+		t.Log("✓ Extension data matches original SGX quote byte-for-byte")
+	}
+
+	// Verify certificate details
+	t.Log("\n" + strings.Repeat("-", 60))
+	t.Log("Certificate Details:")
+	t.Log(strings.Repeat("-", 60))
+	t.Log("✓ Subject: " + issuedCert.Subject.String())
+	t.Log("✓ Issuer: " + issuedCert.Issuer.String())
+	t.Logf("✓ Serial: %s", order.CertificateObject.ID)
+	t.Logf("✓ Valid from: %v", issuedCert.NotBefore)
+	t.Logf("✓ Valid until: %v", issuedCert.NotAfter)
+	t.Logf("✓ DNS Names: %v", issuedCert.DNSNames)
+	t.Logf("✓ Total extensions: %d", len(issuedCert.Extensions))
+
+	// List all extensions
+	t.Log("\nAll extensions in certificate:")
+	for i, ext := range issuedCert.Extensions {
+		marker := ""
+		if ext.Id.Equal(sgxOID) {
+			marker = " ← SGX QUOTE"
+		}
+		t.Logf("  %d. OID: %v (%d bytes)%s", i+1, ext.Id, len(ext.Value), marker)
+	}
+
+	t.Log("\n" + strings.Repeat("=", 60))
+	t.Log("🎉 CompleteOrder() Test PASSED!")
+	t.Log(strings.Repeat("=", 60))
+	t.Log("\nThis confirms that when a real ACME client submits a CSR")
+	t.Log("with SGX extensions to Pebble, the signed certificate will")
+	t.Log("contain the SGX quote exactly as submitted.")
+}
+
+// TestCompleteOrderMultipleExtensions tests CompleteOrder with all 3 SGX extensions
+func TestCompleteOrderMultipleExtensions(t *testing.T) {
+	t.Log("Testing CompleteOrder() with multiple SGX extensions...")
+
+	// Setup
+	logger := log.New(os.Stdout, "TEST: ", log.LstdFlags)
+	ca := New(logger, db.NewMemoryStore(), "", "ecdsa", 0, 1, map[string]Profile{
+		"default": {ValidityPeriod: 7776000},
+	})
+
+	privateKey, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+
+	// Create CSR with 3 SGX extensions
+	quote := make([]byte, 4500)
+	collateral := make([]byte, 1200)
+	token := make([]byte, 800)
+	rand.Read(quote)
+	rand.Read(collateral)
+	rand.Read(token)
+
+	csrTemplate := &x509.CertificateRequest{
+		Subject:  pkix.Name{CommonName: "multi-sgx.example.com"},
+		DNSNames: []string{"multi-sgx.example.com"},
+		ExtraExtensions: []pkix.Extension{
+			{Id: asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 1}, Value: quote},
+			{Id: asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 2}, Value: collateral},
+			{Id: asn1.ObjectIdentifier{1, 3, 6, 1, 4, 1, 99999, 3, 3}, Value: token},
+		},
+	}
+
+	csrDER, _ := x509.CreateCertificateRequest(rand.Reader, csrTemplate, privateKey)
+	parsedCSR, _ := x509.ParseCertificateRequest(csrDER)
+
+	t.Logf("CSR created with %d extensions", len(parsedCSR.Extensions))
+
+	// Create order
+	order := &core.Order{
+		ID:        "multi-ext-order",
+		AccountID: "acct-multi",
+		ParsedCSR: parsedCSR,
+		Order: acme.Order{
+			Profile: "default",
+		},
+	}
+	order.BeganProcessing = true
+
+	mockAuthz := &core.Authorization{}
+	mockAuthz.Status = acme.StatusValid
+	order.AuthorizationObjects = []*core.Authorization{mockAuthz}
+
+	// Call CompleteOrder
+	t.Log("Calling CompleteOrder()...")
+	ca.CompleteOrder(order)
+
+	if order.CertificateObject == nil {
+		t.Fatal("Certificate not issued")
+	}
+
+	// Count SGX extensions in certificate
+	sgxCount := 0
+	for _, ext := range order.CertificateObject.Cert.Extensions {
+		if isSGXExtension(ext.Id) {
+			sgxCount++
+			t.Logf("✓ Found SGX extension: OID %v (%d bytes)",
+				ext.Id, len(ext.Value))
+		}
+	}
+
+	if sgxCount != 3 {
+		t.Errorf("Expected 3 SGX extensions, got %d", sgxCount)
+	} else {
+		t.Log("✅ All 3 SGX extensions preserved by CompleteOrder()")
+	}
+
+	t.Log("✓ Multi-extension test passed")
+}
