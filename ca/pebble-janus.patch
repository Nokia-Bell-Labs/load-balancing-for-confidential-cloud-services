+// Returns whether the given OID matches an allowed SGX extension OID.
+// SGX extensions use OID 1.3.6.1.4.1.99999.3.* (where * can be 1, 2, 3, etc.)
+func isSGXExtension(oid asn1.ObjectIdentifier) bool {
+	for _, prefix := range sgxExtensionOIDPrefixes {
+		if len(oid) == len(prefix)+1 && oidHasPrefix(oid, prefix) {
+			return true
+		}
+	}
+	return false
+}
+
+// Returns whether oid starts with the given prefix.
+func oidHasPrefix(oid, prefix asn1.ObjectIdentifier) bool {
+	if len(oid) < len(prefix) {
+		return false
+	}
+	for i := range prefix {
+		if oid[i] != prefix[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// Returns all SGX extensions from the given extensions array.
+func getSGXExtensions(extensions []pkix.Extension) []pkix.Extension {
+	var sgxExts []pkix.Extension
+	for _, ext := range extensions {
+		if isSGXExtension(ext.Id) {
+			sgxExts = append(sgxExts, ext)
+		}
+	}
+	return sgxExts
+}
