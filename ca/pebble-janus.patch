+// loadPersistentCA loads a persistent CA certificate and private key from PEM files
+func loadPersistentCA(certPath, keyPath string) (*issuer, error) {
+	// Read certificate
+	certPEM, err := os.ReadFile(certPath)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read certificate from %s: %w", certPath, err)
+	}
+	
+	block, _ := pem.Decode(certPEM)
+	if block == nil {
+		return nil, fmt.Errorf("failed to decode PEM block from %s", certPath)
+	}
+	
+	cert, err := x509.ParseCertificate(block.Bytes)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse certificate: %w", err)
+	}
+	
+	// Read private key
+	keyPEM, err := os.ReadFile(keyPath)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read private key from %s: %w", keyPath, err)
+	}
+	
+	keyBlock, _ := pem.Decode(keyPEM)
+	if keyBlock == nil {
+		return nil, fmt.Errorf("failed to decode PEM block from %s", keyPath)
+	}
+	
+	// Try parsing as different key types
+	var key crypto.Signer
+	if parsedKey, err := x509.ParsePKCS8PrivateKey(keyBlock.Bytes); err == nil {
+		key, _ = parsedKey.(crypto.Signer)
+	} else if parsedKey, err := x509.ParseECPrivateKey(keyBlock.Bytes); err == nil {
+		key = parsedKey
+	} else if parsedKey, err := x509.ParsePKCS1PrivateKey(keyBlock.Bytes); err == nil {
+		key = parsedKey
+	} else {
+		return nil, fmt.Errorf("failed to parse private key from %s", keyPath)
+	}
+	
+	if key == nil {
+		return nil, fmt.Errorf("private key is not a crypto.Signer")
+	}
+	
+	// Create core.Certificate wrapper
+	serial := hex.EncodeToString(cert.SerialNumber.Bytes())
+	coreCert := &core.Certificate{
+		ID:   serial,
+		Cert: cert,
+		DER:  cert.Raw,
+	}
+	
+	return &issuer{
+		key:  key,
+		cert: coreCert,
+	}, nil
+}
+
+// loadPersistentChain loads a persistent CA chain from disk
+func (ca *CAImpl) loadPersistentChain() (*chain, error) {
+	// Username-agnostic: honor PEBBLE_CA_CERTS_DIR, else $HOME/pebble/ca_certs
+	// (the frontend container installs the chain under the app user's home).
+	basePath := os.Getenv("PEBBLE_CA_CERTS_DIR")
+	if basePath == "" {
+		if home := os.Getenv("HOME"); home != "" {
+			basePath = home + "/pebble/ca_certs"
+		} else {
+			basePath = "ca_certs"
+		}
+	}
+
+	// Load root CA
+	root, err := loadPersistentCA(
+		fmt.Sprintf("%s/root-ca.pem", basePath),
+		fmt.Sprintf("%s/root-ca-key.pem", basePath),
+	)
+	if err != nil {
+		return nil, fmt.Errorf("failed to load root CA: %w", err)
+	}
+	ca.log.Printf("✓ Loaded persistent root CA: %s", root.cert.Cert.Subject.CommonName)
+	
+	// Load intermediate CA
+	intermediate, err := loadPersistentCA(
+		fmt.Sprintf("%s/intermediate-ca.pem", basePath),
+		fmt.Sprintf("%s/intermediate-ca-key.pem", basePath),
+	)
+	if err != nil {
+		return nil, fmt.Errorf("failed to load intermediate CA: %w", err)
+	}
+	ca.log.Printf("✓ Loaded persistent intermediate CA: %s", intermediate.cert.Cert.Subject.CommonName)
+	
+	// Verify intermediate is signed by root
+	if err := intermediate.cert.Cert.CheckSignatureFrom(root.cert.Cert); err != nil {
+		return nil, fmt.Errorf("intermediate CA is not signed by root CA: %w", err)
+	}
+	ca.log.Printf("✓ Verified intermediate CA is signed by root CA")
+	
+	// Set up issuer chain for intermediate
+	intermediate.cert.IssuerChains = make([][]*core.Certificate, 1)
+	intermediate.cert.IssuerChains[0] = []*core.Certificate{root.cert}
+	
+	// Add certificates to database
+	_, err = ca.db.AddCertificate(root.cert)
+	if err != nil {
+		return nil, fmt.Errorf("failed to add root CA to database: %w", err)
+	}
+	_, err = ca.db.AddCertificate(intermediate.cert)
+	if err != nil {
+		return nil, fmt.Errorf("failed to add intermediate CA to database: %w", err)
+	}
+	
+	return &chain{
+		root:          root,
+		intermediates: []*issuer{intermediate},
+	}, nil
+}
