{
  "manifest_version": 2,
  "name": "Janus Browser Extension",
  "version": "1.0.0",
  "description": "Conduct client-side validation, as part of Janus.",
  
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "<all_urls>",
    "storage",
    "tabs"
  ],
  
  "background": {
    "scripts": [
      "src/lib/util.js",
      "src/lib/storage.js",
      "src/lib/x509-parser.js",
      "src/lib/jwt-verifier.js",
      "src/lib/sgx-validator.js",
      "src/background/background.js"
    ]
  },

  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["src/content/report.js"],
      "run_at": "document_idle"
    }
  ],

  "page_action": {
    "default_icon": {
      "16": "icons/shield-16.png",
      "32": "icons/shield-32.png",
      "48": "icons/shield-48.png"
    },
    "default_title": "Janus Attestation Status",
    "default_popup": "src/popup/popup.html"
  },
  
  "options_ui": {
    "page": "src/settings/settings.html",
    "open_in_tab": true
  },
  
  "web_accessible_resources": [
    "blocked.html"
  ],
  
  "icons": {
    "16": "icons/shield-16.png",
    "32": "icons/shield-32.png",
    "48": "icons/shield-48.png",
    "128": "icons/shield-128.png"
  }
}
