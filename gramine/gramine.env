GRAMINE_TEMPLATE=entrypoint.manifest.template
MANIFEST_FILE=entrypoint.manifest
SGX_RSA_KEY_PATH=keys/signer-key.pem
# Arguments for generating the gramine manifest from the template
work_dir=/home/janus
app_home=/home/janus
log_level=error
ra_type=dcap
ra_client_spid=
ra_client_linkable=0
module_name=frontend
loader_args=-B,-m,home.janus.janus.frontend.frontend_server
