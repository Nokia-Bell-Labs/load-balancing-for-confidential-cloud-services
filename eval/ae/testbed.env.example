# Testbed endpoints for the artifact-evaluation wrappers (eval/ae/*.sh).
#
# On the client VM that we provide, the authors have already copied this file to
# eval/ae/testbed.env. The real addresses are filled in. It is the ONLY place
# where addresses live.  Every eval/ae script renders eval/configs/env.yaml (the file that
# the measurement scripts read) from it (render_env.py). So the two cannot disagree.
# Evaluators do not edit anything.  deploy/client_setup.sh writes this file on
# a new client.

# The directory where each run writes its raw data and figures (a fresh dated directory).
RUN_ROOT="${RUN_ROOT:-${HOME}/ae-results/$(date -u +%Y-%m-%d)}"   # ae.py sets it per run id

# Janus frontend (SGX host): proxy-mode entry point, registration, /route.
FRONTEND_HOST=TBD
FRONTEND_PORT=6037
# Proxy mode for the application benchmarks goes through the own
# /forward endpoint of the frontend inside the enclave (eval/benches/*.py docstrings).

# Backend CVM (SEV-SNP): dc_proxy on BACKEND_PORT (DC-TLS), the vanilla-TLS
# terminator on VANILLA_PORT, the RA+TLS and HTTPA/2 baseline servers.
BACKEND_HOST=TBD
BACKEND_PORT=8443
VANILLA_PORT=8444
# Fronts for the application workloads (Fig. 7): the same dc_proxy / X.509
# terminator. They relay to the hotelReservation stack instead of the app of the measurement scripts.
APP_DC_PORT=8543
APP_VANILLA_PORT=8544
# Web-app fronts for the browser workload (Fig. 7a): the same pair. They relay
# to the confidential web app.  The vanilla one serves a certificate for
# BROWSER_BACKEND from a separate "public" CA. Firefox trusts this CA through a policy.
WEB_DC_PORT=8643
WEB_VANILLA_PORT=8644
RATLS_HOST=TBD
RATLS_PORT=5004
HTTPA_HOST=TBD
HTTPA_PORT=5002

# Attestation service (regional Azure MAA, no credentials needed).
MAA_URL=https://sharedweu.weu.attest.azure.net
# MRENCLAVE of the frontend image that runs on the testbed. check_testbed.sh compares it with the value attested
# in the certificate of the frontend. Then you know which code the running frontend is.
EXPECTED_MRENCLAVE=a0d6cdc4b4636f0921b42f838348bbb67968c55457a73b10811657a1242b837c

# Client-side pieces pre-installed on the client VM.
NSS_HELPER="${HOME}/nss_client/nss_dc_helper"     # DC-capable native client (janus/client/native)
NSS_DB="${HOME}/nss_client/nssdb"                 # NSS trust DB that imports the CA root
RATLS_PYTHON="${HOME}/Janus/baselines/python-ratls/bin/python3"   # interpreter with the RA+TLS bridge
FIREFOX="${HOME}/firefox/firefox"                 # stock Firefox with the enterprise policy that trusts the CA
GECKODRIVER="${HOME}/geckodriver"
EXT_XPI="${HOME}/browser_bench/ctls-ext.xpi"      # the extension in janus/client/browser_extension, packed
BROWSER_FRONTEND=TBD                              # DNS names of the frontend and of the web-app backend. The SAN of the
BROWSER_BACKEND=TBD                               # frontend certificate covers them (the internal DNS of the testbed resolves them, nothing to map)

# Interface toward the servers (RTT injection with tc-netem).
IFACE=eth0

# LLM workload (Fig. 7b), only when the H100 CVM is up, on request.
GPU_HOST=
LLM_PROMPTS="${HOME}/llm_prompts.json"
